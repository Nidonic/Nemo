<?xml version="1.0" encoding="utf-8"?>
<!-- Plain HTTP is allowed so a relay or model server on your own network works (e.g. http://192.168.1.10:8787).
     Only URLs you type in Settings are contacted; the app warns when an http:// URL is not on a local network. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
